/* ─────────────────────────────────────────────────────────────
   ESTADO GLOBAL
────────────────────────────────────────────────────────────── */
let currentLang = localStorage.getItem('wonders_lang') || 'es';
let currentTheme = localStorage.getItem('wonders_theme') || 'dark';
let currentView = '';
let chatOpen = false;
let chatHistory = [];
let chatBusy = false;

/* ─────────────────────────────────────────────────────────────
   ROUTER HASH MINIMO
────────────────────────────────────────────────────────────── */
const VIEWS = ['inicio','que-hacemos','campamento','escuelas','tecnificacion',
               'extraescolares','categorias','equipo','inscripcion','contactanos'];

function navigate(viewId) {
  if (!VIEWS.includes(viewId)) viewId = 'inicio';

  // Ocultar vista actual
  document.querySelectorAll('.view').forEach(function(v) {
    v.classList.remove('view-active');
  });

  // Mostrar vista destino
  var target = document.getElementById('view-' + viewId);
  if (target) {
    target.classList.add('view-active');
    // Scroll al tope sin historia de scroll anterior
    window.scrollTo({ top: 0, behavior: 'instant' });
  }

  // Actualizar hash
  history.pushState({ view: viewId }, '', '#/' + viewId);

  // Marcar nav activo
  document.querySelectorAll('[data-nav]').forEach(function(a) {
    a.classList.toggle('nav-active', a.getAttribute('data-nav') === viewId);
  });

  currentView = viewId;

  // Reiniciar reveal para la nueva vista
  reinitReveal();
}

function routeFromHash() {
  var hash = window.location.hash;
  var viewId = 'inicio';
  if (hash && hash.startsWith('#/')) {
    viewId = hash.slice(2).split('?')[0] || 'inicio';
  }
  navigate(viewId);
}

window.addEventListener('popstate', function(e) {
  var viewId = (e.state && e.state.view) ? e.state.view : 'inicio';
  navigate(viewId);
});

/* ─────────────────────────────────────────────────────────────
   TEMA
────────────────────────────────────────────────────────────── */
function applyTheme(theme) {
  document.documentElement.setAttribute('data-theme', theme);
  var lbl = document.getElementById('themeLabel');
  if (lbl) lbl.textContent = theme === 'dark' ? '☀️' : '🌙';
  localStorage.setItem('wonders_theme', theme);
  currentTheme = theme;
}

function toggleTheme() {
  applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
}

/* ─────────────────────────────────────────────────────────────
   IDIOMA i18n
────────────────────────────────────────────────────────────── */
function setLang(lang) {
  currentLang = lang;
  localStorage.setItem('wonders_lang', lang);
  var t = TRANSLATIONS[lang] || TRANSLATIONS.es;

  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    var key = el.getAttribute('data-i18n');
    if (t[key] !== undefined && el.children.length === 0) {
      el.textContent = t[key];
    }
  });

  document.documentElement.lang = lang;

  var ci = document.getElementById('chatInput');
  if (ci) ci.placeholder = lang === 'es' ? 'Escribe tu pregunta...' : 'Type your question...';

  document.getElementById('btnEs').classList.toggle('active', lang === 'es');
  document.getElementById('btnEn').classList.toggle('active', lang === 'en');
}

/* ─────────────────────────────────────────────────────────────
   MOBILE NAV
────────────────────────────────────────────────────────────── */
function toggleMobile() {
  var nav = document.getElementById('mobileNav');
  var burger = document.getElementById('burger');
  var isOpen = nav.classList.toggle('open');
  burger.classList.toggle('open', isOpen);
  burger.setAttribute('aria-expanded', isOpen);
}

function closeMobile() {
  document.getElementById('mobileNav').classList.remove('open');
  var b = document.getElementById('burger');
  b.classList.remove('open');
  b.setAttribute('aria-expanded', 'false');
}

/* ─────────────────────────────────────────────────────────────
   SCROLL REVEAL
────────────────────────────────────────────────────────────── */
var revealObserver = null;

function initScrollReveal() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
    return;
  }
  if (!('IntersectionObserver' in window)) {
    document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
    return;
  }

  revealObserver = new IntersectionObserver(function(entries) {
    window.__revealOK = true;
    entries.forEach(function(entry, idx) {
      if (entry.isIntersecting) {
        var delay = (idx % 5) * 80;
        setTimeout(function() { entry.target.classList.add('visible'); }, delay);
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

  document.querySelectorAll('.view-active .reveal:not(.visible)').forEach(function(el) {
    revealObserver.observe(el);
  });
}

function reinitReveal() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
    return;
  }
  setTimeout(function() {
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.reveal').forEach(function(el) { el.classList.add('visible'); });
      return;
    }
    if (revealObserver) revealObserver.disconnect();
    revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry, idx) {
        if (entry.isIntersecting) {
          setTimeout(function() { entry.target.classList.add('visible'); }, (idx % 5) * 80);
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

    document.querySelectorAll('.view-active .reveal:not(.visible)').forEach(function(el) {
      revealObserver.observe(el);
    });
    // Fallback inmediato para elementos ya en viewport
    document.querySelectorAll('.view-active .reveal:not(.visible)').forEach(function(el) {
      if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('visible');
    });
  }, 50);
}

/* ─────────────────────────────────────────────────────────────
   FORMULARIOS — AJAX con fetch a formsubmit / degradación a mailto
   Campos ocultos: _subject, _captcha=false, _template=table, pagina
────────────────────────────────────────────────────────────── */
function handlePageForm(e, pageName) {
  e.preventDefault();
  var form = e.target;
  var statusId = 'status' + pageName.charAt(0).toUpperCase() + pageName.slice(1).replace(/-([a-z])/g, function(m,l){ return l.toUpperCase(); });
  // Compatibilidad con IDs específicos definidos en el HTML
  var statusMap = {
    'que-hacemos': 'statusQueHacemos',
    'campamento': 'statusCampamento',
    'escuelas': 'statusEscuelas',
    'tecnificacion': 'statusTecnificacion',
    'extraescolares': 'statusExtraescolares',
    'categorias': 'statusCategorias',
    'equipo': 'statusEquipo',
    'inscripcion': 'statusInscripcion',
    'contactanos': 'statusContactanos'
  };
  var statusEl = document.getElementById(statusMap[pageName] || statusId);
  var t = TRANSLATIONS[currentLang] || TRANSLATIONS.es;

  // Validar nombre y email
  var nameEl = form.querySelector('[name="name"]');
  var emailEl = form.querySelector('[name="email"]');
  if (!nameEl || !nameEl.value.trim() || !emailEl || !emailEl.value.trim()) {
    showFormStatus(statusEl, t.form_err_fields, 'err');
    return;
  }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value.trim())) {
    showFormStatus(statusEl, t.form_err_fields, 'err');
    return;
  }

  // Construir payload
  var submitBtn = form.querySelector('[type="submit"]');
  if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = t.form_sending || 'Enviando…'; }

  var payload = {};
  var elements = form.elements;
  for (var i = 0; i < elements.length; i++) {
    var el = elements[i];
    if (el.name && el.type !== 'submit') payload[el.name] = el.value;
  }
  // Campos obligatorios formsubmit
  payload['_subject'] = 'Wonder\'s Voley — Consulta desde: ' + pageName;
  payload['_captcha'] = 'false';
  payload['_template'] = 'table';
  payload['pagina'] = pageName;

  fetch(WONDERS_FORM_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify(payload)
  })
  .then(function(res) {
    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = t.form_submit || 'Enviar'; }
    if (res.ok) {
      showFormStatus(statusEl, t.form_ok, 'ok');
      form.reset();
    } else {
      degradeToMailto(payload, pageName);
      showFormStatus(statusEl, t.form_ok, 'ok');
    }
  })
  .catch(function() {
    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = t.form_submit || 'Enviar'; }
    // Degradar a mailto
    degradeToMailto(payload, pageName);
    showFormStatus(statusEl, t.form_ok, 'ok');
  });
}

function showFormStatus(el, msg, type) {
  if (!el) return;
  el.textContent = msg;
  el.className = 'form-status ' + type;
  el.style.display = 'block';
  setTimeout(function() { if (el) { el.style.display = 'none'; } }, 7000);
}

function degradeToMailto(payload, pageName) {
  var body = 'Consulta desde página: ' + pageName + '\n\n';
  var skip = ['_subject','_captcha','_template','pagina'];
  Object.keys(payload).forEach(function(k) {
    if (!skip.includes(k)) body += k + ': ' + payload[k] + '\n';
  });
  var mailtoUrl = 'mailto:clubdeportivowonders@gmail.com'
    + '?subject=' + encodeURIComponent(payload['_subject'])
    + '&body=' + encodeURIComponent(body);
  window.open(mailtoUrl, '_blank');
}

/* ─────────────────────────────────────────────────────────────
   CHAT IA — Widget
────────────────────────────────────────────────────────────── */
function toggleChat() {
  chatOpen = !chatOpen;
  var panel = document.getElementById('chatPanel');
  var bubble = document.getElementById('chatBubble');
  panel.classList.toggle('open', chatOpen);
  bubble.setAttribute('aria-expanded', chatOpen);
  if (chatOpen) {
    setTimeout(function() { document.getElementById('chatInput').focus(); }, 300);
  }
}

function handleChatKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendChatMessage(); }
}

function sendSuggestion(btn) {
  document.getElementById('chatInput').value = btn.textContent.trim();
  document.getElementById('chatSuggestions').style.display = 'none';
  sendChatMessage();
}

function appendMsg(role, text) {
  var msgs = document.getElementById('chatMessages');
  var div = document.createElement('div');
  div.classList.add('msg', role === 'user' ? 'msg-user' : 'msg-bot');
  div.textContent = text;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
  return div;
}

function showTyping() {
  var msgs = document.getElementById('chatMessages');
  var div = document.createElement('div');
  div.classList.add('msg', 'msg-bot', 'msg-typing');
  div.id = 'typingIndicator';
  div.innerHTML = '<span></span><span></span><span></span>';
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function removeTyping() {
  var t = document.getElementById('typingIndicator');
  if (t) t.remove();
}

async function sendChatMessage() {
  if (chatBusy) return;
  var input = document.getElementById('chatInput');
  var text = input.value.trim();
  if (!text) return;

  input.value = '';
  document.getElementById('chatSuggestions').style.display = 'none';
  appendMsg('user', text);
  chatHistory.push({ role: 'user', content: text });

  if (!WONDERS_API_URL) {
    var fallback = currentLang === 'es'
      ? 'El asistente IA estará disponible en breve. Por ahora escríbenos al email clubdeportivowonders@gmail.com o llama al +34 614 696 077'
      : 'The AI assistant will be available soon. For now, email us at clubdeportivowonders@gmail.com or call +34 614 696 077';
    appendMsg('bot', fallback);
    chatHistory.push({ role: 'assistant', content: fallback });
    return;
  }

  chatBusy = true;
  document.getElementById('chatSend').disabled = true;
  showTyping();

  var history = chatHistory.slice(-12);

  try {
    var res = await fetch(WONDERS_API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ messages: history, model: CHAT_MODEL, temperature: 0.6, max_tokens: 600 }),
    });

    removeTyping();

    if (!res.ok) {
      var errMsg = currentLang === 'es'
        ? (res.status === 429 ? 'Demasiadas preguntas seguidas. Espera un momento.' : 'El asistente no está disponible. Escríbenos a clubdeportivowonders@gmail.com')
        : (res.status === 429 ? 'Too many requests. Please wait.' : 'Assistant unavailable. Email us at clubdeportivowonders@gmail.com');
      var errDiv = appendMsg('bot', '');
      errDiv.classList.add('msg-error');
      errDiv.textContent = errMsg;
    } else {
      var data = await res.json();
      var reply = data.choices && data.choices[0] && data.choices[0].message
        ? data.choices[0].message.content
        : (currentLang === 'es' ? 'No entendí eso. ¿Puedes reformular?' : 'I didn\'t catch that. Could you rephrase?');
      appendMsg('bot', reply);
      chatHistory.push({ role: 'assistant', content: reply });
    }
  } catch (err) {
    removeTyping();
    var netErr = currentLang === 'es'
      ? 'Sin conexión con el asistente. Comprueba tu internet.'
      : 'No connection to the assistant. Check your internet.';
    var errDiv2 = appendMsg('bot', '');
    errDiv2.classList.add('msg-error');
    errDiv2.textContent = netErr;
  } finally {
    chatBusy = false;
    document.getElementById('chatSend').disabled = false;
    input.focus();
  }
}

/* ─────────────────────────────────────────────────────────────
   INIT
────────────────────────────────────────────────────────────── */
(function init() {
  applyTheme(currentTheme);
  setLang(currentLang);

  // Arrancar router — leer hash inicial
  routeFromHash();

  // Fallback reveal safety net
  setTimeout(function() {
    document.querySelectorAll('.view-active .reveal:not(.visible)').forEach(function(el) {
      if (el.getBoundingClientRect().top < window.innerHeight * 0.95) el.classList.add('visible');
    });
  }, 2500);

  // Cerrar mobile nav al click fuera
  document.addEventListener('click', function(e) {
    var nav = document.getElementById('mobileNav');
    var burger = document.getElementById('burger');
    if (nav.classList.contains('open') && !nav.contains(e.target) && !burger.contains(e.target)) {
      closeMobile();
    }
  });

  // Escape cierra chat
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && chatOpen) toggleChat();
  });
})();
</script>
</body>
</html>

              <label for="camp_nombre" data-i18n="form_name">Nombre</label>
              <input type="text" id="camp_nombre" name="name" required autocomplete="name" placeholder="Tu nombre" />
            </div>
            <div class="form-group">
              <label for="camp_email">Email</label>
              <input type="email" id="camp_email" name="email" required autocomplete="email" placeholder="tu@email.com" />
            </div>
          </div>
          <div class="form-group">
            <label for="camp_edad" data-i18n="form_age_label">Edad de la deportista</label>
            <input type="number" id="camp_edad" name="edad" min="6" max="18" placeholder="Ej: 12" />
          </div>

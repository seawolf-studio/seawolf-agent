  <!-- ═══════════════════════════════════════════════════════════
       ESTILOS
  ════════════════════════════════════════════════════════════════ -->
  <style>
    /* ── Variables de diseño ─────────────────────────────────── */
    :root {
      --primary-black: #000000;
      --accent-red: #E60000;
      --neutral-white: #FFFFFF;
      --seawolf-cyan: #4CE8E7;
      --seawolf-teal: #48E8D8;
      --seawolf-dark: #121E1E;
      --font-head: 'Montserrat', sans-serif;
      --font-body: 'Inter', sans-serif;
      --radius: 6px;
      --transition: background-color 0.3s ease, color 0.3s ease;
    }

    /* ── Tema oscuro (default) ───────────────────────────────── */
    [data-theme="dark"] {
      color-scheme: dark;
      --bg: #000000;
      --bg-surface: #111111;
      --bg-card: #1A1A1A;
      --text: #FFFFFF;
      --text-muted: #AAAAAA;
      --border: #2A2A2A;
      --nav-bg: rgba(0,0,0,0.92);
    }

    /* ── Tema claro ──────────────────────────────────────────── */
    [data-theme="light"] {
      color-scheme: light;
      --bg: #FFFFFF;
      --bg-surface: #F5F5F5;
      --bg-card: #EFEFEF;
      --text: #000000;
      --text-muted: #555555;
      --border: #DDDDDD;
      --nav-bg: rgba(255,255,255,0.95);
    }

    /* ── Selection por tema ──────────────────────────────────── */
    [data-theme="dark"] ::selection { background: var(--accent-red); color: #fff; }
    [data-theme="light"] ::selection { background: var(--accent-red); color: #fff; }

    /* ── Reset y base ────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      scroll-behavior: smooth;
      background: var(--bg);
      transition: var(--transition);
    }

    body {
      font-family: var(--font-body);
      font-size: 1rem;
      line-height: 1.6;
      color: var(--text);
      background: var(--bg);
      transition: var(--transition);
      overflow-x: hidden;
    }

    h1, h2, h3, h4 { font-family: var(--font-head); }

    h1 { font-size: clamp(2rem, 6vw, 3.5rem); font-weight: 800; line-height: 1.1; }
    h2 { font-size: clamp(1.6rem, 4vw, 2.5rem); font-weight: 700; line-height: 1.2; }
    h3 { font-size: clamp(1.2rem, 2.5vw, 1.75rem); font-weight: 600; line-height: 1.3; }
    h4 { font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 500; line-height: 1.4; }

    a { color: var(--accent-red); text-decoration: none; transition: opacity 0.2s; }
    a:hover { opacity: 0.8; }

    img { max-width: 100%; height: auto; display: block; }

    .container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.25rem;
    }

    section { padding: 80px 0; }

    .section-tag {
      display: inline-block;
      font-family: var(--font-head);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--accent-red);
      border: 1px solid var(--accent-red);
      padding: 0.3em 0.8em;
      border-radius: 2px;
      margin-bottom: 1rem;
    }

    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* ── Scroll reveal ───────────────────────────────────────── */
    html.js .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    html.js .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      html.js .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
      * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
    }

    /* ── CTA Button ──────────────────────────────────────────── */
    .btn-cta {
      display: inline-block;
      background: var(--accent-red);
      color: #fff;
      padding: 1rem 2.2rem;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.95rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-radius: var(--radius);
      border: 2px solid var(--accent-red);
      cursor: pointer;
      transition: transform 0.25s cubic-bezier(0.4,0,0.2,1),
                  filter 0.25s ease,
                  box-shadow 0.25s ease;
    }
    .btn-cta:hover {
      transform: scale(1.05);
      filter: brightness(1.2);
      box-shadow: 0 0 25px var(--accent-red);
      color: #fff;
      opacity: 1;
    }
    .btn-cta:active { transform: scale(0.98); }

    .btn-secondary {
      display: inline-block;
      background: transparent;
      color: var(--text);
      padding: 0.9rem 2rem;
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 0.95rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-radius: var(--radius);
      border: 2px solid var(--border);
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .btn-secondary:hover {
      border-color: var(--accent-red);
      color: var(--accent-red);
      opacity: 1;
    }

    /* ════════════════════════════════════════════════════════════
       NAVBAR
    ═════════════════════════════════════════════════════════════ */
    .navbar {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 1000;
      background: var(--nav-bg);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      transition: var(--transition);
    }

    .navbar-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .navbar-logo {
      font-family: var(--font-head);
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--text);
      letter-spacing: 0.02em;
    }
    .navbar-logo span { color: var(--accent-red); }

    .navbar-links {
      display: flex;
      list-style: none;
      gap: 1.4rem;
      align-items: center;
    }
    .navbar-links a {
      color: var(--text);
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: color 0.2s;
      cursor: pointer;
    }
    .navbar-links a:hover,
    .navbar-links a.nav-active { color: var(--accent-red); opacity: 1; }

    /* Dropdown Que Hacemos */
    .nav-dropdown {
      position: relative;
    }
    .nav-dropdown > a {
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .nav-dropdown > a::after {
      content: '▾';
      font-size: 0.65rem;
      transition: transform 0.2s;
    }
    .nav-dropdown:hover > a::after { transform: rotate(180deg); }
    .dropdown-menu {
      position: absolute;
      top: calc(100% + 0.75rem);
      left: 0;
      background: var(--nav-bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      min-width: 200px;
      padding: 0.5rem 0;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-6px);
      transition: opacity 0.2s, transform 0.2s;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .nav-dropdown:hover .dropdown-menu {
      opacity: 1;
      pointer-events: all;
      transform: translateY(0);
    }
    .dropdown-menu a {
      display: block;
      padding: 0.55rem 1rem;
      font-size: 0.8rem;
      color: var(--text);
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: color 0.2s, background 0.2s;
    }
    .dropdown-menu a:hover {
      color: var(--accent-red);
      background: rgba(230,0,0,0.06);
      opacity: 1;
    }

    .navbar-controls {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .toggle-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.4rem 0.75rem;
      border-radius: var(--radius);
      cursor: pointer;
      font-size: 0.8rem;
      font-family: var(--font-head);
      font-weight: 600;
      letter-spacing: 0.04em;
      transition: background 0.2s, border-color 0.2s;
    }
    .toggle-btn:hover { border-color: var(--accent-red); }

    .lang-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 0.4rem 0.65rem;
      border-radius: var(--radius);
      cursor: pointer;
      font-size: 0.8rem;
      font-family: var(--font-head);
      font-weight: 600;
      letter-spacing: 0.06em;
      transition: border-color 0.2s, color 0.2s;
    }
    .lang-btn:hover { border-color: var(--accent-red); color: var(--accent-red); }
    .lang-btn.active { border-color: var(--accent-red); color: var(--accent-red); }

    /* ── Burger ──────────────────────────────────────────────── */
    .burger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 24px;
      height: 16px;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
    }
    .burger span {
      display: block;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.3s, opacity 0.3s;
    }
    .burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .burger.open span:nth-child(2) { opacity: 0; }
    .burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Mobile nav */
    .mobile-nav {
      display: none;
      flex-direction: column;
      background: var(--nav-bg);
      border-top: 1px solid var(--border);
      padding: 1rem 1.25rem;
      gap: 0;
    }
    .mobile-nav.open { display: flex; }
    .mobile-nav a {
      color: var(--text);
      font-size: 0.95rem;
      font-weight: 600;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
    }
    .mobile-nav a:hover { color: var(--accent-red); }
    .mobile-nav .mobile-sub {
      padding-left: 1rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--text-muted);
    }
    .mobile-nav .mobile-sub:hover { color: var(--accent-red); }

    @media (max-width: 900px) {
      .navbar-links { display: none; }
      .burger { display: flex; }
    }

    /* ════════════════════════════════════════════════════════════
       ROUTER — SISTEMA DE VISTAS (hash routing)
    ═════════════════════════════════════════════════════════════ */

    /* Todas las vistas ocultas por defecto via JS.
       Sin JS: todo visible (noscript fallback). */
    .view { display: block; }

    html.js .view { display: none; }
    html.js .view.view-active { display: block; }

    /* Breadcrumb de subpáginas */
    .page-hero {
      min-height: 38vh;
      display: flex;
      align-items: flex-end;
      padding-top: 64px;
      background: #000;
      position: relative;
      overflow: hidden;
    }
    .page-hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse at 20% 60%, rgba(230,0,0,0.1) 0%, transparent 55%),
        linear-gradient(170deg, #0d0d0d 0%, #000 100%);
    }
    .page-hero-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(230,0,0,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(230,0,0,0.05) 1px, transparent 1px);
      background-size: 60px 60px;
      animation: gridDrift 20s linear infinite;
      opacity: 0.4;
    }
    .page-hero-content {
      position: relative;
      z-index: 1;
      padding: 2.5rem 0 3rem;
    }
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.75rem;
      color: rgba(255,255,255,0.4);
      margin-bottom: 1rem;
      font-family: var(--font-head);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .breadcrumb a {
      color: rgba(255,255,255,0.4);
      transition: color 0.2s;
    }
    .breadcrumb a:hover { color: var(--accent-red); opacity: 1; }
    .breadcrumb span { color: var(--accent-red); }
    .page-hero-content h1 {
      color: #fff;
      font-size: clamp(1.8rem, 5vw, 3rem);
    }
    .page-hero-content p {
      color: rgba(255,255,255,0.55);
      margin-top: 0.75rem;
      font-size: clamp(0.9rem, 1.8vw, 1.1rem);
      max-width: 560px;
    }

    /* ════════════════════════════════════════════════════════════
       HERO — cinematico (solo vista inicio)
    ═════════════════════════════════════════════════════════════ */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      background: #000;
      padding-top: 64px;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      /* [REEMPLAZAR: foto real del equipo en la pista o competencia — imagen horizontal alta resolución] */
      background:
        radial-gradient(ellipse at 20% 50%, rgba(230,0,0,0.12) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 30%, rgba(230,0,0,0.07) 0%, transparent 50%),
        linear-gradient(170deg, #0d0d0d 0%, #000 100%);
      z-index: 0;
    }

    .hero-bg::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(230,0,0,0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(230,0,0,0.06) 1px, transparent 1px);
      background-size: 60px 60px;
      animation: gridDrift 20s linear infinite;
      opacity: 0.5;
    }
    @keyframes gridDrift {
      0% { transform: translateY(0); }
      100% { transform: translateY(60px); }
    }

    .hero-ball {
      position: absolute;
      right: 8%;
      top: 50%;
      transform: translateY(-50%);
      width: min(38vw, 420px);
      aspect-ratio: 1;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #fff 0%, #e60000 40%, #8b0000 80%, #2a0000 100%);
      box-shadow: 0 0 80px rgba(230,0,0,0.35), inset 0 0 40px rgba(0,0,0,0.5);
      animation: ballFloat 6s ease-in-out infinite;
      opacity: 0.18;
      pointer-events: none;
    }
    @keyframes ballFloat {
      0%, 100% { transform: translateY(-50%) scale(1); }
      50% { transform: translateY(calc(-50% - 20px)) scale(1.03); }
    }

    .hero-content {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 860px;
      padding: 2rem 1.25rem;
    }

    .hero-badge {
      display: inline-block;
      background: rgba(230,0,0,0.15);
      border: 1px solid rgba(230,0,0,0.4);
      color: var(--accent-red);
      font-family: var(--font-head);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      padding: 0.4em 1em;
      border-radius: 100px;
      margin-bottom: 1.5rem;
      opacity: 0;
      animation: heroFadeUp 0.7s ease forwards 0.2s;
    }

    .hero-content h1 {
      color: #fff;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      opacity: 0;
      animation: heroFadeUp 0.8s ease forwards 0.5s;
    }

    .hero-tagline {
      font-family: var(--font-head);
      font-size: clamp(1.1rem, 2.5vw, 1.6rem);
      color: var(--accent-red);
      font-weight: 700;
      margin-bottom: 1.2rem;
      opacity: 0;
      animation: heroFadeUp 0.8s ease forwards 0.8s;
    }

    .hero-sub {
      font-size: clamp(0.95rem, 1.8vw, 1.15rem);
      color: rgba(255,255,255,0.7);
      max-width: 560px;
      margin: 0 auto 1rem;
      opacity: 0;
      animation: heroFadeUp 0.8s ease forwards 1.0s;
    }

    .hero-lema {
      font-family: var(--font-head);
      font-size: clamp(0.85rem, 1.5vw, 1rem);
      font-weight: 600;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 2.5rem;
      opacity: 0;
      animation: heroFadeUp 0.8s ease forwards 1.2s;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      opacity: 0;
      animation: heroFadeUp 0.8s ease forwards 1.4s;
    }

    .hero-stats {
      display: flex;
      gap: 2rem;
      justify-content: center;
      margin-top: 3.5rem;
      flex-wrap: wrap;
      opacity: 0;
      animation: heroFadeUp 0.8s ease forwards 1.7s;
    }
    .hero-stat { text-align: center; }
    .hero-stat strong {
      display: block;
      font-family: var(--font-head);
      font-size: clamp(1.5rem, 3vw, 2rem);
      font-weight: 800;
      color: var(--accent-red);
    }
    .hero-stat span {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.5);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    @keyframes heroFadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .scroll-indicator {
      position: absolute;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      opacity: 0.4;
      animation: heroFadeUp 0.8s ease forwards 2.1s;
    }
    .scroll-indicator span {
      font-size: 0.65rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #fff;
    }
    .scroll-line {
      width: 1px;
      height: 40px;
      background: linear-gradient(to bottom, #fff, transparent);
      animation: scrollPulse 2s ease-in-out infinite;
    }
    @keyframes scrollPulse {
      0%, 100% { opacity: 0.4; transform: scaleY(1); }
      50% { opacity: 1; transform: scaleY(1.2); }
    }

    /* ════════════════════════════════════════════════════════════
       SECCION ESENCIAL HOME — resumen + nav cards
    ═════════════════════════════════════════════════════════════ */
    .home-nav-cards { background: var(--bg-surface); }

    .nav-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .nav-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem 1.5rem;
      cursor: pointer;
      transition: border-color 0.25s, transform 0.25s;
      text-decoration: none;
      color: var(--text);
      display: block;
    }
    .nav-card:hover {
      border-color: var(--accent-red);
      transform: translateY(-4px);
      color: var(--text);
      opacity: 1;
    }
    .nav-card-icon { font-size: 2.2rem; margin-bottom: 1rem; display: block; }
    .nav-card h3 { font-size: 1.05rem; margin-bottom: 0.4rem; font-weight: 700; }
    .nav-card p { font-size: 0.85rem; color: var(--text-muted); line-height: 1.5; }
    .nav-card-arrow {
      display: inline-block;
      margin-top: 0.75rem;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent-red);
    }

    /* ════════════════════════════════════════════════════════════
       QUIENES SOMOS
    ═════════════════════════════════════════════════════════════ */
    .quienes { background: var(--bg-surface); }

    .quienes-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: center;
    }

    .quienes-img {
      position: relative;
      aspect-ratio: 4/5;
      background: var(--bg-card);
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--border);
    }
    .quienes-img::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(230,0,0,0.15) 0%, transparent 60%);
    }
    .img-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 0.8rem;
      text-align: center;
      padding: 1rem;
      gap: 0.5rem;
    }
    .img-placeholder svg { opacity: 0.3; }
    /* [REEMPLAZAR: foto equipo 2026 Wonder's — vertical, alta resolución] */

    .quienes-badge {
      display: flex;
      gap: 0.75rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }
    .badge {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 0.4em 0.9em;
      font-size: 0.78rem;
      font-weight: 600;
    }
    .badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-red); }

    .quienes-text p { color: var(--text-muted); margin-bottom: 1rem; }
    .quienes-text strong { color: var(--text); }

    .titulo-rojo { color: var(--accent-red); }

    @media (max-width: 768px) {
      .quienes-grid { grid-template-columns: 1fr; gap: 2rem; }
      .quienes-img { aspect-ratio: 16/9; }
    }

    /* ════════════════════════════════════════════════════════════
       VALORES
    ═════════════════════════════════════════════════════════════ */
    .valores { background: var(--bg); }

    .valores-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
    }

    .valor-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.75rem 1.5rem;
      transition: border-color 0.25s, transform 0.25s;
      cursor: default;
    }
    .valor-card:hover { border-color: var(--accent-red); transform: translateY(-4px); }

    .valor-icon { font-size: 2rem; margin-bottom: 1rem; display: block; }
    .valor-card h3 { font-size: 1.05rem; margin-bottom: 0.5rem; font-weight: 700; }
    .valor-card p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; }

    /* ════════════════════════════════════════════════════════════
       QUE HACEMOS — programas
    ═════════════════════════════════════════════════════════════ */
    .programas { background: var(--bg-surface); }

    .programas-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .programa-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.25s, transform 0.25s;
    }
    .programa-card:hover { border-color: var(--accent-red); transform: translateY(-4px); }

    .programa-img {
      aspect-ratio: 16/9;
      background: linear-gradient(135deg, #1a0000, #3d0000);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .programa-img img {
      width: 100%; height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
    }
    .programa-img .programa-num {
      font-family: var(--font-head);
      font-size: 5rem;
      font-weight: 800;
      color: rgba(230,0,0,0.2);
      user-select: none;
    }
    .programa-img .programa-emoji {
      position: absolute;
      font-size: 3rem;
    }

    .programa-body { padding: 1.75rem; }
    .programa-body h3 { margin-bottom: 0.25rem; font-size: 1.2rem; }
    .programa-period {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent-red);
      margin-bottom: 0.75rem;
    }
    .programa-body p { font-size: 0.9rem; color: var(--text-muted); margin-bottom: 1.25rem; }
    .programa-pending {
      font-size: 0.78rem;
      color: var(--text-muted);
      background: var(--bg-surface);
      border-left: 2px solid var(--border);
      padding: 0.5rem 0.75rem;
      border-radius: 0 var(--radius) var(--radius) 0;
      font-style: italic;
    }

    /* ════════════════════════════════════════════════════════════
       EXTRAESCOLARES
    ═════════════════════════════════════════════════════════════ */
    .extraescolares { background: var(--bg); }

    .extra-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.75rem;
      margin-top: 3rem;
    }
    .extra-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem 1.75rem;
      transition: border-color 0.25s, transform 0.25s;
    }
    .extra-card:hover { border-color: var(--accent-red); transform: translateY(-4px); }
    .extra-icon { font-size: 2.5rem; margin-bottom: 1rem; display: block; }
    .extra-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
    .extra-card p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1rem; }
    .extra-tag {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      background: rgba(230,0,0,0.1);
      color: var(--accent-red);
      border: 1px solid rgba(230,0,0,0.3);
      border-radius: 100px;
      padding: 0.25em 0.75em;
    }

    /* ════════════════════════════════════════════════════════════
       CATEGORIAS Y HORARIOS
    ═════════════════════════════════════════════════════════════ */
    .categorias { background: var(--bg); }

    .cat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin-top: 3rem;
    }

    .cat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      position: relative;
      overflow: hidden;
      transition: border-color 0.25s;
    }
    .cat-card:hover { border-color: var(--accent-red); }
    .cat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 4px;
      height: 100%;
      background: var(--accent-red);
    }

    .cat-card h3 { margin-bottom: 0.4rem; }
    .cat-ages {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-style: italic;
      margin-bottom: 1.25rem;
    }

    .schedule-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }
    .schedule-table th {
      text-align: left;
      padding: 0.4rem 0;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.6rem;
    }
    .schedule-table td {
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border);
      color: var(--text);
    }
    .schedule-table td:first-child { color: var(--accent-red); font-weight: 600; }

    .horario-banner {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      margin-top: 2rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .horario-icon { font-size: 2.5rem; }
    .horario-info h4 { margin-bottom: 0.25rem; }
    .horario-info p { font-size: 0.9rem; color: var(--text-muted); }

    @media (max-width: 768px) {
      .cat-grid { grid-template-columns: 1fr; }
    }

    /* ════════════════════════════════════════════════════════════
       EQUIPO
    ═════════════════════════════════════════════════════════════ */
    .equipo { background: var(--bg-surface); }

    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.75rem;
      margin-top: 3rem;
    }

    .team-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      text-align: center;
      transition: border-color 0.25s, transform 0.25s;
    }
    .team-card:hover { border-color: var(--accent-red); transform: translateY(-4px); }

    .team-photo {
      aspect-ratio: 1;
      background: linear-gradient(135deg, #1a0000, #2d0000);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.5rem;
      color: rgba(230,0,0,0.25);
      position: relative;
      overflow: hidden;
    }
    .team-photo img {
      width: 100%; height: 100%;
      object-fit: cover;
      position: absolute;
      inset: 0;
    }
    /* [REEMPLAZAR: foto entrenadora principal (exfigura del voleibol colombiano)] */
    /* [REEMPLAZAR: fotos del cuerpo técnico — nombres y roles pendientes de la hermana] */

    .team-body { padding: 1.25rem 1rem; }
    .team-body h3 { font-size: 1rem; margin-bottom: 0.2rem; }
    .team-role {
      font-size: 0.78rem;
      color: var(--accent-red);
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .team-body p {
      font-size: 0.83rem;
      color: var(--text-muted);
      margin-top: 0.6rem;
      line-height: 1.5;
    }

    /* ════════════════════════════════════════════════════════════
       PRUEBA SOCIAL
    ═════════════════════════════════════════════════════════════ */
    .social-proof { background: #000; position: relative; overflow: hidden; }

    .social-proof::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(230,0,0,0.08) 0%, transparent 70%);
    }

    .trophies {
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 4rem;
    }

    .trophy {
      text-align: center;
      padding: 2.5rem 3rem;
      background: rgba(230,0,0,0.05);
      border: 1px solid rgba(230,0,0,0.2);
      border-radius: var(--radius);
      position: relative;
      z-index: 1;
    }
    .trophy-icon { font-size: 3.5rem; display: block; margin-bottom: 0.75rem; }
    .trophy h3 { font-size: clamp(1rem, 2vw, 1.3rem); color: #fff; margin-bottom: 0.25rem; }
    .trophy span { font-size: 0.8rem; color: rgba(255,255,255,0.5); letter-spacing: 0.08em; }

    .testimonios-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 3rem;
      position: relative;
      z-index: 1;
    }

    .testimonio {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: var(--radius);
      padding: 1.75rem;
    }
    .testimonio-stars { color: #FFB800; font-size: 1rem; margin-bottom: 0.75rem; }
    .testimonio p {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.6;
      margin-bottom: 1rem;
      font-style: italic;
    }
    .testimonio-author {
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(255,255,255,0.45);
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    /* [REEMPLAZAR: testimonios reales de familias y jugadoras — pendiente de la hermana] */

    /* ════════════════════════════════════════════════════════════
       INSCRIPCION — CTA
    ═════════════════════════════════════════════════════════════ */
    .inscripcion { background: var(--bg-surface); }

    .inscripcion-box {
      background: linear-gradient(135deg, #1a0000 0%, #0d0000 100%);
      border: 1px solid rgba(230,0,0,0.3);
      border-radius: calc(var(--radius) * 2);
      padding: clamp(2.5rem, 6vw, 5rem);
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .inscripcion-box::before {
      content: '';
      position: absolute;
      top: -30%; left: 50%;
      transform: translateX(-50%);
      width: 60%; height: 60%;
      background: radial-gradient(circle, rgba(230,0,0,0.15) 0%, transparent 70%);
      pointer-events: none;
    }

    .inscripcion-box h2 { color: #fff; margin-bottom: 0.75rem; }
    .inscripcion-box p {
      color: rgba(255,255,255,0.65);
      max-width: 540px;
      margin: 0 auto 2rem;
      font-size: 1rem;
    }

    .inscripcion-steps {
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .step {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.65);
    }
    .step-num {
      width: 26px; height: 26px;
      background: var(--accent-red);
      color: #fff;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      font-family: var(--font-head);
      flex-shrink: 0;
    }

    .inscripcion-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ════════════════════════════════════════════════════════════
       FORMULARIOS — estilos compartidos
    ═════════════════════════════════════════════════════════════ */
    .page-form-wrapper {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2.5rem 2rem;
      margin-top: 3rem;
    }
    .page-form-wrapper h3 { margin-bottom: 0.5rem; }
    .page-form-wrapper .form-subtitle {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-bottom: 1.75rem;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }
    @media (max-width: 600px) {
      .form-row { grid-template-columns: 1fr; }
    }
    .form-group { margin-bottom: 1.2rem; }
    .form-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }
    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
      color: var(--text);
      font-family: var(--font-body);
      font-size: 0.95rem;
      transition: border-color 0.2s;
      -webkit-appearance: none;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--accent-red);
    }
    .form-group textarea { resize: vertical; min-height: 100px; }
    .form-submit {
      width: 100%;
      background: var(--accent-red);
      color: #fff;
      border: none;
      padding: 0.9rem;
      border-radius: var(--radius);
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      transition: filter 0.2s, transform 0.2s;
      margin-top: 0.5rem;
    }
    .form-submit:hover { filter: brightness(1.15); transform: translateY(-1px); }
    .form-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .form-status {
      margin-top: 0.75rem;
      font-size: 0.82rem;
      color: var(--text-muted);
      display: none;
      padding: 0.6rem 0.9rem;
      border-radius: var(--radius);
      background: var(--bg-surface);
      border: 1px solid var(--border);
    }
    .form-status.ok { border-color: #4ade80; color: #4ade80; }
    .form-status.err { border-color: var(--accent-red); color: var(--accent-red); }

    /* ════════════════════════════════════════════════════════════
       CONTACTO
    ═════════════════════════════════════════════════════════════ */
    .contacto { background: var(--bg); }

    .contacto-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      margin-top: 3rem;
    }

    .contacto-channels { display: flex; flex-direction: column; gap: 1rem; }

    .channel {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      text-decoration: none;
      transition: border-color 0.25s, transform 0.2s;
      color: var(--text);
    }
    .channel:hover {
      border-color: var(--accent-red);
      transform: translateX(4px);
      color: var(--text);
      opacity: 1;
    }
    .channel-icon {
      width: 44px; height: 44px;
      background: rgba(230,0,0,0.1);
      border: 1px solid rgba(230,0,0,0.2);
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .channel-info { min-width: 0; }
    .channel-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.1rem;
    }
    .channel-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .socials { margin-top: 2rem; }
    .socials p {
      font-size: 0.82rem;
      color: var(--text-muted);
      margin-bottom: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .social-links { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .social-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.6rem 1rem;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text);
      transition: border-color 0.2s, color 0.2s;
    }
    .social-link:hover {
      border-color: var(--accent-red);
      color: var(--accent-red);
      opacity: 1;
    }

    /* Formulario de contacto rápido (v1 compat) */
    .contact-form { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; }
    .contact-form h3 { margin-bottom: 1.5rem; }

    @media (max-width: 768px) {
      .contacto-grid { grid-template-columns: 1fr; }
    }

    /* ════════════════════════════════════════════════════════════
       FOOTER
    ═════════════════════════════════════════════════════════════ */
    footer {
      background: #000;
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 3rem 0 2rem;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem;
      margin-bottom: 3rem;
    }

    .footer-brand h3 { font-size: 1.1rem; color: #fff; margin-bottom: 0.5rem; }
    .footer-brand .lema {
      font-size: 0.82rem;
      color: rgba(255,255,255,0.4);
      font-style: italic;
      margin-bottom: 1rem;
    }
    .footer-brand p {
      font-size: 0.83rem;
      color: rgba(255,255,255,0.35);
      max-width: 260px;
    }

    .footer-col h4 {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      margin-bottom: 1rem;
    }
    .footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
    .footer-col ul a {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.55);
      transition: color 0.2s;
      cursor: pointer;
    }
    .footer-col ul a:hover { color: var(--accent-red); opacity: 1; }

    .footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 2rem;
      border-top: 1px solid rgba(255,255,255,0.05);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-copy { font-size: 0.78rem; color: rgba(255,255,255,0.25); }
    .footer-copy a { color: rgba(255,255,255,0.4); }
    .footer-copy a:hover { color: rgba(255,255,255,0.7); opacity: 1; }

    .seawolf-sig {
      font-size: 0.72rem;
      color: var(--seawolf-cyan);
      font-family: var(--font-head);
      font-weight: 600;
      letter-spacing: 0.1em;
      opacity: 0.6;
      transition: opacity 0.2s;
    }
    .seawolf-sig:hover { opacity: 1; }

    @media (max-width: 768px) {
      .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
      .footer-bottom { flex-direction: column; text-align: center; }
    }

    /* ════════════════════════════════════════════════════════════
       WIDGET CHAT IA — Smart Endpoint
    ═════════════════════════════════════════════════════════════ */
    .chat-bubble {
      position: fixed;
      bottom: 1.75rem;
      right: 1.75rem;
      z-index: 9000;
      width: 56px;
      height: 56px;
      background: var(--accent-red);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(230,0,0,0.5);
      transition: transform 0.2s, box-shadow 0.2s;
      border: none;
    }
    .chat-bubble:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(230,0,0,0.65); }
    .chat-bubble svg { width: 24px; height: 24px; fill: #fff; }

    .chat-panel {
      position: fixed;
      bottom: 5.5rem;
      right: 1.75rem;
      z-index: 9000;
      width: min(380px, calc(100vw - 2rem));
      height: min(520px, calc(100vh - 8rem));
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 8px 40px rgba(0,0,0,0.45);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transform: scale(0.9) translateY(16px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.25s cubic-bezier(0.4,0,0.2,1),
                  opacity 0.25s ease;
    }
    .chat-panel.open {
      transform: scale(1) translateY(0);
      opacity: 1;
      pointer-events: all;
    }

    .chat-header {
      background: var(--accent-red);
      padding: 0.9rem 1.25rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }
    .chat-header-info { display: flex; align-items: center; gap: 0.75rem; }
    .chat-avatar {
      width: 36px; height: 36px;
      background: rgba(255,255,255,0.2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }
    .chat-header-text h4 { font-size: 0.9rem; color: #fff; margin-bottom: 0.1rem; }
    .chat-status {
      font-size: 0.7rem;
      color: rgba(255,255,255,0.8);
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }
    .chat-status::before {
      content: '';
      width: 6px; height: 6px;
      background: #4ade80;
      border-radius: 50%;
      display: inline-block;
    }
    .chat-close {
      background: none;
      border: none;
      color: rgba(255,255,255,0.8);
      cursor: pointer;
      font-size: 1.3rem;
      line-height: 1;
      padding: 0.2rem;
    }
    .chat-close:hover { color: #fff; }

    .chat-messages {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .chat-messages::-webkit-scrollbar { width: 4px; }
    .chat-messages::-webkit-scrollbar-track { background: transparent; }
    .chat-messages::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

    .msg {
      max-width: 82%;
      padding: 0.7rem 1rem;
      border-radius: 10px;
      font-size: 0.875rem;
      line-height: 1.5;
      word-break: break-word;
    }
    .msg-bot { background: var(--bg-surface); border: 1px solid var(--border); color: var(--text); align-self: flex-start; }
    .msg-user { background: var(--accent-red); color: #fff; align-self: flex-end; }
    .msg-typing { display: flex; gap: 4px; align-items: center; padding: 0.7rem 1rem; }
    .msg-typing span {
      width: 7px; height: 7px;
      background: var(--text-muted);
      border-radius: 50%;
      animation: typingPulse 1.2s ease-in-out infinite;
    }
    .msg-typing span:nth-child(2) { animation-delay: 0.2s; }
    .msg-typing span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes typingPulse {
      0%, 100% { opacity: 0.3; transform: translateY(0); }
      50% { opacity: 1; transform: translateY(-4px); }
    }

    .msg-error {
      background: rgba(230,0,0,0.1);
      border: 1px solid rgba(230,0,0,0.3);
      color: var(--text-muted);
      font-size: 0.8rem;
      font-style: italic;
      align-self: center;
      max-width: 90%;
      text-align: center;
    }

    .chat-suggestions {
      display: flex;
      gap: 0.5rem;
      padding: 0 1rem 0.5rem;
      flex-wrap: wrap;
    }
    .chat-suggestion {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      color: var(--text-muted);
      border-radius: 100px;
      padding: 0.35em 0.85em;
      font-size: 0.75rem;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
    }
    .chat-suggestion:hover { border-color: var(--accent-red); color: var(--accent-red); }

    .chat-input-row {
      display: flex;
      gap: 0.5rem;
      padding: 0.75rem 1rem 0.9rem;
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }
    .chat-input {
      flex: 1;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 100px;
      padding: 0.6rem 1rem;
      color: var(--text);
      font-family: var(--font-body);
      font-size: 0.875rem;
    }
    .chat-input:focus { outline: none; border-color: var(--accent-red); }
    .chat-send {
      width: 38px; height: 38px;
      background: var(--accent-red);
      border: none;
      border-radius: 50%;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: filter 0.2s;
      flex-shrink: 0;
    }
    .chat-send:hover { filter: brightness(1.2); }
    .chat-send:disabled { opacity: 0.4; cursor: not-allowed; }
    .chat-send svg { width: 16px; height: 16px; fill: #fff; }

    .chat-footer {
      padding: 0.4rem 1rem;
      text-align: center;
      font-size: 0.65rem;
      color: var(--seawolf-cyan);
      opacity: 0.5;
      border-top: 1px solid var(--border);
      flex-shrink: 0;
    }

    /* ── Utilidades responsive ───────────────────────────────── */
    @media (max-width: 375px) {
      section { padding: 60px 0; }
      .hero-actions { flex-direction: column; align-items: center; }
    }

    @media (max-width: 768px) {
      .inscripcion-steps { flex-direction: column; align-items: flex-start; }
      .nav-cards-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) {
      .nav-cards-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>


<!-- ════════════════════════════════════════════════════════════
     VISTA: INSCRIPCION
═════════════════════════════════════════════════════════════ -->
<div class="view" id="view-inscripcion">
  <div class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <nav class="breadcrumb" aria-label="Ruta">
        <a href="#/inicio" onclick="navigate('inicio');return false;" data-i18n="nav_inicio">Inicio</a>
        <span>›</span>
        <span data-i18n="nav_inscripcion">Inscripción</span>
      </nav>
      <h1 data-i18n="insc_page_h1">Inscripción</h1>
      <p data-i18n="insc_page_sub">Reserva tu plaza para la temporada 2026/2027.</p>
    </div>
  </div>

  <section class="inscripcion" aria-labelledby="inscripcionH2">
    <div class="container">
      <div class="inscripcion-box reveal">
        <span class="section-tag" data-i18n="insc_tag">Únete al club</span>
        <h2 id="inscripcionH2" data-i18n="insc_h2">¿Lista para jugar?<br>Apuntarse es <span style="color:var(--accent-red)">fácil.</span></h2>
        <p data-i18n="insc_p">Reserva tu plaza para la temporada 2026/2027. Tres pasos y listo.</p>

        <div class="inscripcion-steps">
          <div class="step">
            <span class="step-num">1</span>
            <span data-i18n="step1">Elige tu categoría</span>
          </div>
          <div class="step">
            <span class="step-num">2</span>
            <span data-i18n="step2">Rellena el formulario</span>
          </div>
          <div class="step">
            <span class="step-num">3</span>
            <span data-i18n="step3">¡A entrenar!</span>
          </div>
        </div>

        <div class="inscripcion-actions">
          <!-- [REEMPLAZAR: confirmar enlace Cluber con la hermana] -->
          <a href="https://app.cluber.es/legacy/clubes/6a298cd45d19c937959488/ajustes#custom-forms-section"
             class="btn-cta" target="_blank" rel="noopener" data-i18n="insc_cta">
            Reservar plaza en Cluber
          </a>
        </div>
      </div>
    </div>
  </section>

  <section style="background:var(--bg);padding:60px 0 80px;">
    <div class="container">
      <div class="page-form-wrapper reveal" style="max-width:680px;margin:0 auto;">
        <h3 data-i18n="form_insc_title">Formulario de pre-inscripción</h3>
        <p class="form-subtitle" data-i18n="form_insc_sub">Rellena este formulario y te contactamos para completar la inscripción. No te comprometes a nada todavía.</p>
        <form id="formInscripcion" onsubmit="handlePageForm(event,'inscripcion')" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="ins_nombre" data-i18n="form_name">Nombre</label>
              <input type="text" id="ins_nombre" name="name" required autocomplete="name" placeholder="Nombre de la deportista" />
            </div>
            <div class="form-group">
              <label for="ins_tutor" data-i18n="form_tutor_label">Tutor / Madre / Padre</label>
              <input type="text" id="ins_tutor" name="tutor" autocomplete="name" placeholder="Nombre del tutor" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="ins_email">Email</label>
              <input type="email" id="ins_email" name="email" required autocomplete="email" placeholder="tu@email.com" />
            </div>
            <div class="form-group">
              <label for="ins_edad" data-i18n="form_age_label">Edad</label>
              <input type="number" id="ins_edad" name="edad" min="6" max="18" placeholder="Ej: 12" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="ins_categoria" data-i18n="form_categoria_label">Categoría</label>
              <select id="ins_categoria" name="categoria">
                <option value="" data-i18n="form_cat_opt0">Selecciona categoría</option>
                <option value="Infantil" data-i18n="cat1_h3">Infantil</option>
                <option value="Cadete" data-i18n="cat2_h3">Cadete</option>
                <option value="No sé todavía" data-i18n="form_cat_opt3">No sé todavía</option>
              </select>
            </div>
            <div class="form-group">
              <label for="ins_programa" data-i18n="form_programa_label">Programa</label>
              <select id="ins_programa" name="programa">
                <option value="" data-i18n="form_programa_opt0">Selecciona programa</option>
                <option value="Escuelas de Voleibol" data-i18n="p2_h3">Escuelas de Voleibol</option>
                <option value="Campamento de Verano" data-i18n="p1_h3">Campamento de Verano</option>
                <option value="Tecnificación" data-i18n="p3_h3">Tecnificación</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="ins_msg" data-i18n="form_msg">Mensaje (opcional)</label>
            <textarea id="ins_msg" name="message" placeholder="¿Alguna duda o información adicional?"></textarea>
          </div>
          <button type="submit" class="form-submit" data-i18n="form_preinsc_btn">Enviar pre-inscripción</button>
          <div class="form-status" id="statusInscripcion"></div>
        </form>
      </div>
    </div>
  </section>
</div><!-- /view-inscripcion -->



              <input type="text" id="ext_nombre" name="name" required autocomplete="name" placeholder="Tu nombre" />
            </div>
            <div class="form-group">
              <label for="ext_email">Email</label>
              <input type="email" id="ext_email" name="email" required autocomplete="email" placeholder="tu@email.com" />
            </div>
          </div>
          <div class="form-group">
            <label for="ext_centro" data-i18n="form_school_label">Centro educativo</label>
            <input type="text" id="ext_centro" name="centro" placeholder="Nombre del colegio o instituto" />
          </div>
          <div class="form-group">
            <label for="ext_msg" data-i18n="form_msg">Mensaje</label>
            <textarea id="ext_msg" name="message" required placeholder="Cuéntanos qué necesitas"></textarea>
          </div>
          <button type="submit" class="form-submit" data-i18n="form_contact_btn">Contactar</button>
          <div class="form-status" id="statusExtraescolares"></div>
        </form>
      </div>
    </div>
  </section>
</div><!-- /view-extraescolares -->



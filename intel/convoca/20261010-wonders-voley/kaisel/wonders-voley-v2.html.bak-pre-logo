<!-- ════════════════════════════════════════════════════════════
     VISTA: INICIO
═════════════════════════════════════════════════════════════ -->
<div class="view" id="view-inicio">

  <!-- HERO -->
  <section class="hero" id="inicio" aria-labelledby="heroH1">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-ball" aria-hidden="true"></div>

    <div class="hero-content">
      <div class="hero-badge" data-i18n="hero_badge">🏆 Campeonas AMB &amp; Copa Stars 2026</div>

      <h1 id="heroH1">
        Club Deportivo<br>Wonder<span style="color:var(--accent-red)">'</span>s Voley
      </h1>

      <p class="hero-tagline" data-i18n="hero_tagline">Talento, equipo y valores.</p>

      <p class="hero-sub" data-i18n="hero_sub">
        Escuela de voleibol en Madrid para jóvenes que quieren jugar, crecer y ganar. Entrenamos por edades. Formamos deportistas. Y también personas.
      </p>

      <p class="hero-lema" data-i18n="hero_lema">6 en la pista, 1 corazón</p>

      <div class="hero-actions">
        <a href="#/inscripcion" class="btn-cta" onclick="navigate('inscripcion');return false;" data-i18n="hero_cta">Reserva tu plaza</a>
        <a href="#/que-hacemos" class="btn-secondary" onclick="navigate('que-hacemos');return false;" data-i18n="hero_secondary">Ver programas</a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <strong>2</strong>
          <span data-i18n="stat_titles">Títulos 2026</span>
        </div>
        <div class="hero-stat">
          <strong>2</strong>
          <span data-i18n="stat_cats">Categorías</span>
        </div>
        <div class="hero-stat">
          <strong>3</strong>
          <span data-i18n="stat_programs">Programas</span>
        </div>
        <div class="hero-stat">
          <strong>Mar/Jue</strong>
          <span data-i18n="stat_days">Entrenamos</span>
        </div>
      </div>
    </div>

    <div class="scroll-indicator" aria-hidden="true">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- QUIENES SOMOS (home) -->
  <section class="quienes reveal" id="quienes" aria-labelledby="quienesH2">
    <div class="container">
      <div class="quienes-grid">
        <div class="quienes-img reveal">
          <!-- [REEMPLAZAR: foto equipo Wonder's 2026 — vertical, alta resolución, podio o entrenamiento] -->
          <div class="img-placeholder">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span>Foto equipo Wonder's</span>
            <span style="font-size:.7rem;opacity:.5">[REEMPLAZAR con imagen real]</span>
          </div>
        </div>

        <div class="quienes-text reveal">
          <span class="section-tag" data-i18n="quienes_tag">Quiénes somos</span>
          <h2 id="quienesH2" data-i18n="quienes_h2">Más que voleibol,<br><span class="titulo-rojo">formación real.</span></h2>
          <p data-i18n="quienes_p1">Somos una escuela de voleibol en Madrid. Nacimos para que los jóvenes aprendan el deporte de verdad.</p>
          <p data-i18n="quienes_p2">Aquí no solo se entrena el golpeo. Se entrena el carácter. Trabajo en equipo. Esfuerzo. Diversión. Eso es Wonder's.</p>
          <p data-i18n="quienes_p3"><strong>Nuestro objetivo es claro:</strong> formar deportistas y, sobre todo, personas. Y lo cumplimos. En 2026 fuimos campeonas AMB y Copa Stars.</p>
          <div class="quienes-badge">
            <span class="badge"><span class="dot"></span><span data-i18n="badge_amb">Campeonas AMB 2026</span></span>
            <span class="badge"><span class="dot"></span><span data-i18n="badge_copa">Copa Stars 2026</span></span>
            <span class="badge"><span class="dot"></span><span data-i18n="badge_madrid">Madrid, España</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NAV CARDS HOME — acceso rápido a todas las secciones -->
  <section class="home-nav-cards">
    <div class="container">
      <div class="reveal" style="text-align:center;max-width:640px;margin:0 auto 0.5rem;">
        <span class="section-tag" data-i18n="home_nav_tag">Explora el club</span>
        <h2 data-i18n="home_nav_h2">Todo lo que necesitas saber,<br>en un clic.</h2>
      </div>
      <div class="nav-cards-grid">
        <a class="nav-card reveal" href="#/que-hacemos" onclick="navigate('que-hacemos');return false;">
          <span class="nav-card-icon">🏐</span>
          <h3 data-i18n="nc1_title">Qué hacemos</h3>
          <p data-i18n="nc1_desc">Campamento de verano, Escuelas de Voleibol y Tecnificación. Elige tu programa.</p>
          <span class="nav-card-arrow" data-i18n="nc_arrow">Ver más →</span>
        </a>
        <a class="nav-card reveal" href="#/extraescolares" onclick="navigate('extraescolares');return false;">
          <span class="nav-card-icon">🏫</span>
          <h3 data-i18n="nc2_title">Extraescolares</h3>

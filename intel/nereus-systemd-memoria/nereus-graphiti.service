[Unit]
Description=NEREUS temporal stack (Graphiti MCP + Neo4j)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nereus/graphiti/mcp_server/docker
ExecStart=/usr/bin/docker compose -f docker-compose-neo4j.yml -f docker-compose.neox.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose-neo4j.yml -f docker-compose.neox.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

[Unit]
Description=NEREUS memory stack (Mem0 + pgvector)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nereus/mem0/server
ExecStart=/usr/bin/docker compose -f docker-compose.yaml -f docker-compose.override.yml up -d mem0 postgres
ExecStop=/usr/bin/docker compose -f docker-compose.yaml -f docker-compose.override.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
